
# GitHub AI Agent - Example Configuration

# GitHub API settings
# Public repositories are accessed without authentication.
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT_SECONDS=15
GITHUB_MAX_FILES=20
GITHUB_MAX_FILE_BYTES=65536
GITHUB_MAX_TOTAL_BYTES=524288

# LLM settings - Disabled by default
LLM_ENABLED=false
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Never put a real API key in this example file
LLM_API_KEY=

# LLM usage limits
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_CONTEXT_TOKENS=12000
LLM_MAX_OUTPUT_TOKENS=1000

# Repository caching
REPOSITORY_CACHE_TTL_SECONDS=600

# Local SQLite FTS5 retrieval (no external embedding service)
RAG_SQLITE_PATH=data/repository_index.sqlite3
RAG_MAX_FILES=40
RAG_MAX_FILE_BYTES=131072
RAG_MAX_TOTAL_BYTES=5242880
RAG_MAX_REQUESTS=50
RAG_MAX_CHUNKS=1000
RAG_CHUNK_LINES=80
RAG_CHUNK_OVERLAP_LINES=15
RAG_RETRIEVED_CHUNKS=10
